{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasonscript-package-checksums/1.0",
  "type": "object",
  "required": ["schema_version", "algorithm", "files"],
  "properties": {
    "schema_version": {"const": "reasonscript-package-checksums/1.0"},
    "algorithm": {"const": "sha256"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^payload/"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
