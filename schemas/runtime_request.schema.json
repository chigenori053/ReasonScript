{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonscript.dev/schemas/runtime_request.schema.json",
  "title": "ReasonScript Runtime Request 1.0",
  "type": "object",
  "required": ["schema", "request_id", "operation", "program", "context"],
  "properties": {
    "schema": {"const": "reasonscript-runtime-request/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"const": "execute"},
    "program": {"type": "object"},
    "context": {
      "type": "object",
      "required": ["resource_root", "capabilities", "limits", "trace", "numeric_mode"],
      "properties": {
        "resource_root": {"type": "string"},
        "capabilities": {
          "type": "object",
          "properties": {
            "filesystem_read": {"type": "boolean"},
            "filesystem_write": {"type": "boolean"},
            "network": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "limits": {"type": "object"},
        "trace": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "mode": {"enum": ["off", "delta", "full", "sampled"]},
            "checkpoint_interval": {"type": "integer", "minimum": 0},
            "max_bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "numeric_mode": {"enum": ["compat-reference", "native-fast"]},
        "backend": {"enum": ["RuntimeReal", "HybridRuntime"]},
        "reason_units": {"enum": ["off", "ru", "ru_rus", "ru_rus_ruo"]},
        "executable_reason_units": {"enum": ["off", "count", "full"]},
        "causal_evaluation": {"enum": ["off", "dependency", "counterfactual", "full"]},
        "causal_observation_source": {"enum": ["external", "native", "merge"]},
        "state_causality": {"enum": ["off", "trace", "full"]},
        "reasoning_state": {"enum": ["off", "lightweight"]},
        "max_causal_depth": {"type": "integer", "minimum": 0},
        "max_counterfactual_runs": {"type": "integer", "minimum": 0},
        "causal_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ru_id"],
            "properties": {
              "ru_id": {"type": "string", "minLength": 1},
              "produces": {"type": "array", "items": {"type": "string"}},
              "requires": {"type": "array", "items": {"type": "string"}},
              "requires_any": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
              "blocked_by": {"type": "array", "items": {"type": "string"}},
              "success": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "benchmark_metrics": {"type": "boolean"},
        "reasoning": {
          "type": "object",
          "properties": {"semantic_events": {"type": "boolean"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
