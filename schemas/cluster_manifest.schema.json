{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonscript.org/schema/cluster-manifest/0.1",
  "title": "ReasonScript Cluster Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "cluster_id", "mode", "status", "artifacts"],
  "properties": {
    "schema_version": {"const": "reasonscript-cluster-manifest/0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "cluster_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["single_process", "local_process", "simulation", "single_node"]},
    "status": {"enum": ["completed", "failed", "partial", "aborted"]},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["file", "bytes", "checksum"], "properties": {"file": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}
  }
}
