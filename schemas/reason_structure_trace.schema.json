{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reason_units",
    "reason_structures",
    "spatial_objects",
    "relations",
    "execution_states",
    "execution_bindings",
    "execution_relations",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "reasonscript-reason-structure-trace/0.1"
    },
    "reason_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RU"
      }
    },
    "reason_structures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RUS"
      }
    },
    "spatial_objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RUO"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Relation"
      }
    },
    "execution_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExecutionState"
      }
    },
    "execution_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExecutionBinding"
      }
    },
    "execution_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExecutionRelation"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          }
        }
      }
    },
    "mode": {
      "enum": [
        "off",
        "ru",
        "rus",
        "rus_with_state"
      ]
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru_sequence_hash",
        "reason_structure_hash",
        "spatial_object_hash",
        "execution_state_sequence_hash",
        "execution_binding_sequence_hash",
        "hypothesis_sequence_hash"
      ],
      "properties": {
        "ru_sequence_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reason_structure_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "spatial_object_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution_state_sequence_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution_binding_sequence_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "hypothesis_sequence_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasonscript-reason-structure-trace/0.1",
  "$defs": {
    "RU": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "kind": {
          "type": "string",
          "pattern": "\\S"
        },
        "content": {}
      }
    },
    "RUS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_refs",
        "relation_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "unit_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "RUO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "space",
        "coordinate_frame",
        "coordinate_unit",
        "unit_refs",
        "structure_refs",
        "relation_refs",
        "placements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "space": {
          "enum": [
            "physical",
            "abstract"
          ]
        },
        "coordinate_frame": {
          "type": "string",
          "pattern": "\\S"
        },
        "coordinate_unit": {
          "type": "string",
          "pattern": "\\S"
        },
        "unit_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "structure_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          },
          "minItems": 1
        }
      }
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "kind",
        "source_ref",
        "target_ref",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "domain": {
          "enum": [
            "non_spatial",
            "spatial_3d"
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "target_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "content": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "domain": {
                "const": "non_spatial"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "Dependency",
                  "Cause",
                  "Logical",
                  "Hierarchy",
                  "IsA",
                  "PartOf",
                  "Constraint",
                  "Similar"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "spatial_3d"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "Position",
                  "Direction",
                  "Distance",
                  "Adjacent",
                  "Contains",
                  "Spatial"
                ]
              }
            }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "position",
        "direction"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "RU",
                "RUS"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[^\\s]+:[^\\s]*$"
            }
          }
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "direction": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ExecutionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "changed_fields",
        "goal_status",
        "semantic_subject"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal_status": {
          "enum": [
            "ACTIVE",
            "REACHED"
          ]
        },
        "semantic_subject": {}
      }
    },
    "ExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason_unit_ref",
        "execution_state_ref",
        "evidence_refs",
        "execution_relation_refs",
        "status",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "reason_unit_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "execution_state_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          }
        },
        "execution_relation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          }
        },
        "status": {
          "enum": [
            "CREATED",
            "ACTIVE",
            "VERIFIED",
            "REJECTED",
            "COMPLETED"
          ]
        },
        "lifecycle": {
          "type": "array",
          "items": {
            "enum": [
              "CREATED",
              "ACTIVE",
              "COMPLETED"
            ]
          }
        }
      }
    },
    "ExecutionRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_ref",
        "target_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "target_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        }
      }
    }
  }
}
