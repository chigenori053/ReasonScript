{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonscript.org/schemas/reasonunit_language/canonical_artifact.schema.json",
  "title": "RUO-N2 canonical artifact",
  "type": "object",
  "required": ["schema_version", "profile_version", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^reasonscript-reasonunit-language-integration-.+/1\\.0$"},
    "profile_version": {"const": "reasonscript-reasonunit-language-integration/1.0"},
    "data": {"type": "object"}
  }
}

