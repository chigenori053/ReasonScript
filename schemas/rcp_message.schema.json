{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "message_id",
    "source",
    "destination",
    "kind",
    "correlation_id",
    "causation_id",
    "trace",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "reasonscript-rcp-message/0.2"
    },
    "protocol_version": {
      "const": "0.2"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[^\\s]+:[^\\s]*$"
    },
    "source": {
      "type": "string",
      "pattern": "^[^\\s]+:[^\\s]*$"
    },
    "destination": {
      "type": "string",
      "pattern": "^[^\\s]+:[^\\s]*$"
    },
    "kind": {
      "enum": [
        "REQUEST",
        "RESULT",
        "UNKNOWN_REPORT"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[^\\s]+:[^\\s]*$"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\s]+:[^\\s]*$"
      },
      "uniqueItems": true
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasonscript-rcp-message/0.2",
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "RU",
            "RUS",
            "RUO",
            "Relation",
            "Evidence",
            "Knowledge",
            "ExecutionState",
            "ExecutionBinding",
            "ExecutionRelation",
            "NativeObject",
            "URU",
            "URUS",
            "URUO",
            "UnknownRelation"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence",
        "candidate"
      ],
      "properties": {
        "state": {
          "enum": [
            "OPEN",
            "IN_PROGRESS",
            "CANDIDATE",
            "RESOLVED",
            "REOPENED",
            "BLOCKED"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "candidate": {}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origins",
        "cause",
        "grounds",
        "dependencies",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "cause": {
          "enum": [
            "MissingKnowledge",
            "MissingEvidence",
            "Ambiguous",
            "Conflict",
            "Dependency"
          ]
        },
        "grounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          },
          "minItems": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "value",
        "references"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "value": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[^\\s]+:[^\\s]*$"
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "RU"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/RU"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "RUS"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/RUS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "RUO"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/RUO"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "Relation"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/Relation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "ExecutionState"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/ExecutionState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "ExecutionBinding"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/ExecutionBinding"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "ExecutionRelation"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/ExecutionRelation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "URU"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/URUInformation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "URUS"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/URUS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "URUO"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/URUO"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference": {
                "properties": {
                  "kind": {
                    "const": "UnknownRelation"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/UnknownRelation"
              }
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "unknowns"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "minItems": 1
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        }
      }
    },
    "RU": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "kind": {
          "type": "string",
          "pattern": "\\S"
        },
        "content": {}
      }
    },
    "RUS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_refs",
        "relation_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "unit_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "RUO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "space",
        "coordinate_frame",
        "coordinate_unit",
        "unit_refs",
        "structure_refs",
        "relation_refs",
        "placements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "space": {
          "enum": [
            "physical",
            "abstract"
          ]
        },
        "coordinate_frame": {
          "type": "string",
          "pattern": "\\S"
        },
        "coordinate_unit": {
          "type": "string",
          "pattern": "\\S"
        },
        "unit_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "structure_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          },
          "minItems": 1
        }
      }
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "kind",
        "source_ref",
        "target_ref",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "domain": {
          "enum": [
            "non_spatial",
            "spatial_3d"
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "target_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "content": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "domain": {
                "const": "non_spatial"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "Dependency",
                  "Cause",
                  "Logical",
                  "Hierarchy",
                  "IsA",
                  "PartOf",
                  "Constraint",
                  "Similar"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "spatial_3d"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "Position",
                  "Direction",
                  "Distance",
                  "Adjacent",
                  "Contains",
                  "Spatial"
                ]
              }
            }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "position",
        "direction"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "RU",
                "RUS"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[^\\s]+:[^\\s]*$"
            }
          }
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "direction": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ExecutionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "changed_fields",
        "goal_status",
        "semantic_subject"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal_status": {
          "enum": [
            "ACTIVE",
            "REACHED"
          ]
        },
        "semantic_subject": {}
      }
    },
    "ExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason_unit_ref",
        "execution_state_ref",
        "evidence_refs",
        "execution_relation_refs",
        "status",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "reason_unit_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "execution_state_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          }
        },
        "execution_relation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          }
        },
        "status": {
          "enum": [
            "CREATED",
            "ACTIVE",
            "VERIFIED",
            "REJECTED",
            "COMPLETED"
          ]
        },
        "lifecycle": {
          "type": "array",
          "items": {
            "enum": [
              "CREATED",
              "ACTIVE",
              "COMPLETED"
            ]
          }
        }
      }
    },
    "ExecutionRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_ref",
        "target_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "target_ref": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        }
      }
    },
    "URUInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "known_information",
        "missing_information",
        "evidence_refs",
        "knowledge_refs",
        "causal_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "known_information": {},
        "missing_information": {},
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "knowledge_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "causal_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "Relation",
                  "UnknownRelation"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[^\\s]+:[^\\s]*$"
              }
            }
          }
        }
      }
    },
    "UnknownRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "kind": {
          "enum": [
            "DEPENDS_ON",
            "CAUSED_BY",
            "BLOCKS",
            "RELATED_TO",
            "CONFLICTS_WITH"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "URU"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[^\\s]+:[^\\s]*$"
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "URU",
                "RU",
                "RUS",
                "RUO"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[^\\s]+:[^\\s]*$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DEPENDS_ON",
                  "CAUSED_BY",
                  "RELATED_TO",
                  "CONFLICTS_WITH"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "URU"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[^\\s]+:[^\\s]*$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "URUS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uru_refs",
        "relation_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s]*$"
        },
        "uru_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s]+:[^\\s]*$"
          },
          "uniqueItems": true,
          "minItems": 0
        }
      }
    },
    "unknownPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "status",
        "position"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "URU",
                "URUS"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[^\\s]+:[^\\s]*$"
            }
          }
        },
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "position": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "else": {
            "properties": {
              "position": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "unknownConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "target",
        "distance"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ADJACENT",
            "CONTAINS",
            "DISTANCE"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "URU",
                "URUS"
              ]
            },
            "id": {
              "type": "string",
