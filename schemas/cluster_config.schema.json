{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonscript.org/schema/cluster-config/0.1",
  "title": "ReasonScript Cluster Configuration 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cluster_id", "mode", "coordinator", "workers", "execution"],
  "properties": {
    "schema_version": {"const": "reasonscript-cluster-config/0.1"},
    "cluster_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["single_process", "local_process", "simulation"]},
    "coordinator": {"$ref": "#/$defs/node"},
    "workers": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/node"}, {"type": "object", "required": ["capacity"], "properties": {"capacity": {"type": "integer", "minimum": 1}}}]}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["sync_policy", "max_retries", "fallback", "deterministic"], "properties": {"sync_policy": {"enum": ["none", "barrier", "coordinator"]}, "max_retries": {"type": "integer", "minimum": 0}, "fallback": {"enum": ["none", "single_node", "abort", "partial"]}, "deterministic": {"const": true}}},
    "limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "testing": {"type": "object"}
  },
  "$defs": {"node": {"type": "object", "required": ["node_id"], "properties": {"node_id": {"type": "string", "minLength": 1}}, "additionalProperties": true}}
}
