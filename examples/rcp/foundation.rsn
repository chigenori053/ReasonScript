module RCPFoundation {
  import RCPReference
  import RCPUnknown
  import RCPTransition
  import RCPValidator
  import RCPMessage
  struct ReasonRecord {
    id: string
    kind: string
    content: string
  }
  struct EvidenceRecord {
    id: string
    value: string
  }
  // Example domain policy; production domains supply their own decision.
  fn Evaluate(candidate: string, evidence: [Reference]) -> ValidationDecision {
    return RCPValidator::Decision(candidate == "answer" && evidence.length > 0, "example domain policy")
  }
  calculation SerializedRequest -> string {
    let reference = Reference { kind: "RU", id: "ru:request" }
    let value = ReasonRecord { id: "ru:request", kind: "query", content: "domain question" }
    let record = Record { reference: reference, value_json: serialize.json(value), references: [] }
    let unit = RCPUnknown::CreateUnknown("unknown:request", [reference], "MissingKnowledge", [], [])
    result = RCPMessage::Encode(RCPMessage::Request("message:request", "dsn:a", "dsn:b", "conversation:request", Payload { records: [record], unknowns: [unit] }))
  }
  calculation FoundationChecks -> bool {
    let unit = RCPUnknown::CreateUnknown("unknown:1", [Reference { kind: "RU", id: "ru:1" }], "MissingEvidence", [], [])
    let evidence = [Reference { kind: "Evidence", id: "evidence:1" }]
    let accepted = Evaluate("answer", evidence)
    let active = RCPTransition::Advance(unit, "IN_PROGRESS", "", [], accepted)
    let retry = RCPTransition::Advance(active, "OPEN", "", [], accepted)
    let candidate = RCPTransition::Advance(active, "CANDIDATE", "answer", evidence, accepted)
    let rejected = RCPTransition::Advance(candidate, "OPEN", "", [], accepted)
    let resolved = RCPTransition::Advance(candidate, "RESOLVED", "answer", evidence, accepted)
    let reopened = RCPTransition::Advance(resolved, "REOPENED", "", evidence, accepted)
    let reset = RCPTransition::Advance(reopened, "OPEN", "", [], accepted)
    let bad = RCPTransition::Advance(active, "CANDIDATE", "wrong", evidence, Evaluate("wrong", evidence))
    let invalid = RCPTransition::Advance(unit, "RESOLVED", "answer", evidence, accepted)
    let blocked = RCPTransition::BlockIfLimit(active, 3, 3)
    result = RCPUnknown::CurrentState(retry) == "OPEN" && RCPUnknown::CurrentState(rejected) == "OPEN" && candidate.history[2].candidate == some("answer") && RCPUnknown::CurrentState(reset) == "OPEN" && reset.history[3].state == "RESOLVED" && reset.origins == unit.origins && reset.id == unit.id && reset.history.length == 6 && RCPUnknown::CurrentState(bad) == "IN_PROGRESS" && RCPUnknown::CurrentState(invalid) == "OPEN" && RCPUnknown::CurrentState(blocked) == "BLOCKED" && !RCPTransition::CanTransition("BLOCKED", "RESOLVED") && !RCPTransition::CanTransition("RESOLVED", "OPEN") && RCPUnknown::CurrentState(RCPTransition::BlockIfLimit(active, 2, 3)) == "IN_PROGRESS"
  }
  calculation SerializedReevaluation -> string {
    let origin = Reference { kind: "RU", id: "ru:request" }
    let evidence = [Reference { kind: "Evidence", id: "evidence:1" }]
    let accepted = Evaluate("answer", evidence)
    let unit = RCPUnknown::CreateUnknown("unknown:request", [origin], "MissingEvidence", evidence, [])
    let active = RCPTransition::Advance(unit, "IN_PROGRESS", "", [], accepted)
    let retry = RCPTransition::Advance(active, "OPEN", "", [], accepted)
    let again = RCPTransition::Advance(retry, "IN_PROGRESS", "", [], accepted)
    let candidate = RCPTransition::Advance(again, "CANDIDATE", "answer", evidence, accepted)
    let reject = RCPTransition::Advance(candidate, "OPEN", "", [], accepted)
    let restarted = RCPTransition::Advance(reject, "IN_PROGRESS", "", [], accepted)
    let newCandidate = RCPTransition::Advance(restarted, "CANDIDATE", "answer", evidence, accepted)
    let resolved = RCPTransition::Advance(newCandidate, "RESOLVED", "answer", evidence, accepted)
    let reopened = RCPTransition::Advance(resolved, "REOPENED", "", evidence, accepted)
    let reset = RCPTransition::Advance(reopened, "OPEN", "", [], accepted)
    let blocked = RCPTransition::BlockIfLimit(reset, 8, 8)
    let ru = Record { reference: origin, value_json: serialize.json(ReasonRecord { id: "ru:request", kind: "query", content: "domain question" }), references: [] }
    let ev = Record { reference: evidence[0], value_json: serialize.json(EvidenceRecord { id: "evidence:1", value: "expired observation" }), references: [] }
    result = RCPMessage::Encode(RCPMessage::Build("message:reevaluation", "dsn:a", "dsn:b", "UNKNOWN_REPORT", "conversation:reevaluation", none, [], Payload { records: [ru, ev], unknowns: [blocked] }))
  }
}
